.venv/
__pycache__/
*.pyc
.DS_Store

# Runtime state, not content. The app creates it on first write, and the
# server's copy lives in the Docker bind mount — committing it would mean
# every game you play shows up as a diff.
data/stats.json

# Seeded from games/ito/default_topics.json on first run; edited in the app.
data/ito/topics.json

# Flip 7 games played on the app's deck, saved after every move so a
# restart doesn't end them. Runtime state, like stats.json.
data/flip7/

# Fugitive and Wildwood games, saved the same way.
data/fugitive/
data/wildwood/

# Player profiles and their photos — people, not content.
data/profiles.json
data/profiles/

# Last-good copies and in-flight temp files from core/jsonfile.py.
data/**/*.bak
data/**/.*.tmp

# Generated by XcodeGen from ios/project.yml — edit that, not the project.
ios/GameNight.xcodeproj/
ios/build/
xcuserdata/

# Claude Code worktrees (parallel working copies), never part of the repo
.claude/worktrees/
